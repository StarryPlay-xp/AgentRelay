// AgentRelay 的公共编译设置（进仓库）。
// 个人设置（开发者团队编号、应用标识前缀、签名方式）写在同目录的 Local.xcconfig，不进仓库，格式见 Local.xcconfig.example。
// 没有 Local.xcconfig 时，按“仅在本机运行”签名，应用标识为 local.dev.AgentRelay，任何人克隆后都能直接构建。

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
MARKETING_VERSION = 0.1.0
// 构建号：每次给自己装新的正式版都加 1，便于分清装的是哪一份
CURRENT_PROJECT_VERSION = 2

AGENTRELAY_BUNDLE_PREFIX = local.dev
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = YES
// 正式构建不带调试权限 get-task-allow：Xcode 默认给“仅在本机运行”的签名也注入它，带着它别的程序就能挂上来读写进程内存。
// 调试构建保留，Xcode 才能挂调试器。
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

#include? "Local.xcconfig"
